<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinderSecondary"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_status_bar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/top_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_time"
            style="@style/StatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="12:45" />

        <ImageView
            android:id="@+id/icon_gps"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_gps"
            app:tint="@color/yellow_status" />

        <ImageView
            android:id="@+id/icon_battery"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_battery" />

        <TextView
            android:id="@+id/text_temp"
            style="@style/StatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="35°C" />

    </LinearLayout>

    <!-- Recording Indicators -->
    <LinearLayout
        android:id="@+id/rec_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_status_bar">

        <ImageView
            android:id="@+id/rec_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_rec"
            app:tint="@color/red_rec" />

        <TextView
            android:id="@+id/text_rec_time"
            style="@style/StatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/red_rec"
            tools:text="00:12:45" />
    </LinearLayout>

    <!-- Speed Indicator -->
    <TextView
        android:id="@+id/text_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/white"
        android:textSize="48sp"
        android:shadowColor="@color/black"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintBottom_toTopOf="@id/bottom_control_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="84 km/h" />

    <!-- Bottom Control Bar -->
    <LinearLayout
        android:id="@+id/bottom_control_bar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#B0000000"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btn_lock"
            style="@style/ControlButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_lock" />

        <Space
            android:layout_width="32dp"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/btn_rec"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/ic_rec"
            android:backgroundTint="@color/red_rec"
            android:elevation="4dp" />

        <Space
            android:layout_width="32dp"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/btn_gallery"
            style="@style/ControlButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_gallery" />

        <ImageButton
            android:id="@+id/btn_settings"
            style="@style/ControlButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_settings" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
